#!/bin/sh

set -e

# Project to analyze: the repository running the hook (also when the stack is a submodule).
STACK_PROJECT_ROOT="$(git rev-parse --show-toplevel)"
export STACK_PROJECT_ROOT

# Uncomment the checks to run before each push.
#!/bin/sh

echo "================================"
echo " Running Trivy security scan"
echo "================================"

docker compose --profile security run --rm -T trivy || exit 1

echo "================================"
echo " Generating Trivy Markdown report"
echo "================================"

docker compose --profile security run --rm -T trivy-report || exit 1

echo "Trivy report generated: reports/trivy/trivy-report.md"

echo "================================"
echo " Running SonarQube analysis"
echo "================================"

docker compose --profile security run --rm -T sonar-scanner
